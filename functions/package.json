{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "build": "rm -rf lib && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node test/tests.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "moment-timezone": "^0.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "private": true
}
